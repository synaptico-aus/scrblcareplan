# Database Configuration
# Primary database connection (Neon for development, AWS RDS for production)
DATABASE_URL=postgresql://user:password@host:port/database

# AWS RDS Configuration (Production - Sydney region ap-southeast-2)
# If AWS_RDS_HOST is set, it takes precedence over DATABASE_URL
AWS_RDS_HOST=your-rds-instance.ap-southeast-2.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DATABASE=scrbl_production
AWS_RDS_USER=your-rds-username
AWS_RDS_PASSWORD=your-rds-password

# Session Configuration
# REQUIRED in production - use a strong random string
SESSION_SECRET=your-session-secret-min-32-characters

# OpenAI API Configuration
# REQUIRED for AI-powered care plan generation
OPENAI_API_KEY=sk-your-openai-api-key

# AWS S3 Configuration (Client document storage - Sydney region)
# REQUIRED for file uploads
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Object Storage Configuration (set by Replit Object Storage integration)
PUBLIC_OBJECT_SEARCH_PATHS=/public
PRIVATE_OBJECT_DIR=/.private

# Replit Configuration (automatically set by Replit)
REPL_ID=your-repl-id
REPLIT_DOMAINS=your-domain.replit.app
ISSUER_URL=https://replit.com

# Server Configuration
NODE_ENV=production
PORT=5000

# Production Deployment Checklist:
# ✓ Set SESSION_SECRET to a strong random value
# ✓ Configure AWS RDS database in Sydney (ap-southeast-2)
# ✓ Set up AWS S3 bucket in Sydney for Australian data residency
# ✓ Add OpenAI API key for AI features
# ✓ Verify all AWS credentials are correct
# ✓ Ensure NODE_ENV=production for security features
